---
import { useTranslations, getPathWithoutLang } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pathNoLang = getPathWithoutLang(Astro.url);

const navLinks = [
  { href: "#properties", label: t("nav.mandates") },
  { href: "#sell-rent", label: t("nav.sellRent") },
  { href: "#about", label: t("nav.about") },
  { href: "#testimonials", label: t("nav.testimonials") },
  { href: "#contact", label: t("nav.contact") },
];

const buildLangPath = (code: Lang) => {
  if (code === "pt") return pathNoLang === "/" ? "/" : pathNoLang;
  return `/${code}${pathNoLang === "/" ? "" : pathNoLang}`;
};

const langs: Lang[] = ["pt", "fr", "en"];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href={lang === "pt" ? "/" : `/${lang}/`} class="flex items-center" aria-label="TurnKey">
      <img src="/logo.svg" alt="TurnKey" class="h-14 md:h-16 w-auto" />
    </a>
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-semibold text-[var(--color-anthracite)] hover:text-[var(--color-orange)] transition">
          {link.label}
        </a>
      ))}
      <a href="tel:+351962350026" class="hidden md:flex items-center gap-2 text-sm font-semibold text-[var(--color-anthracite)] hover:text-[var(--color-orange)] transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        +351 962 350 026
      </a>
      <div class="flex items-center gap-2 pl-6 border-l border-gray-200">
        {langs.map((code, i) => (
          <>
            {i > 0 && <span class="text-gray-300">|</span>}
            <a
              href={buildLangPath(code)}
              data-lang-switch={code}
              class={`text-sm font-semibold transition ${
                lang === code
                  ? "text-[var(--color-orange)]"
                  : "text-gray-400 hover:text-[var(--color-anthracite)]"
              }`}
              aria-current={lang === code ? "page" : undefined}
            >
              {t(("switcher." + code) as any)}
            </a>
          </>
        ))}
      </div>
    </nav>
    <button id="mobile-menu-btn" class="md:hidden p-2" aria-label={t("nav.openMenu")}>
      <svg class="w-6 h-6 text-[var(--color-anthracite)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <nav id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
    <div class="px-6 py-4 flex flex-col gap-4">
      {navLinks.map((link) => (
        <a href={link.href} class="text-base font-semibold text-[var(--color-anthracite)] hover:text-[var(--color-orange)] transition">
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-3 pt-3 border-t border-gray-100">
        {langs.map((code) => (
          <a
            href={buildLangPath(code)}
            data-lang-switch={code}
            class={`text-sm font-semibold ${
              lang === code
                ? "text-[var(--color-orange)]"
                : "text-gray-500"
            }`}
          >
            {t(("switcher." + code) as any)}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  // Persist language choice when the user clicks the switcher
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((el) => {
    el.addEventListener("click", () => {
      try {
        const code = el.getAttribute("data-lang-switch");
        if (code) localStorage.setItem("tkLang", code);
      } catch (e) {
        // ignore
      }
    });
  });
</script>
