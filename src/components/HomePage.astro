  <div class="relative bg-white rounded-lg shadow-2xl max-w-md w-full p-8">
    <button type="button" data-close aria-label={t("modal.close")} class="absolute top-3 right-4 text-gray-400 hover:text-[var(--color-anthracite)] text-3xl leading-none">×</button>
    <h3 class="text-2xl font-bold text-[var(--color-anthracite)] mb-2 text-center">{t("modal.choiceTitle")}</h3>
    <p class="text-sm text-[var(--color-anthracite)]/70 mb-6 text-center">{t("modal.choiceIntro")}</p>
    <div class="space-y-3">
      <button type="button" data-modal="seller" class="block w-full bg-[var(--color-orange)] text-white py-4 rounded-md font-semibold hover:opacity-90 transition">{t("hero.ctaSell")}</button>
      <button type="button" data-modal="buyer" class="block w-full bg-[var(--color-anthracite)] text-white py-4 rounded-md font-semibold hover:opacity-90 transition">{t("hero.ctaBuy")}</button>
    </div>
  </div>
</div>

<script>
  (function(){
    function open(id: string){closeAll();var m=document.getElementById('modal-'+id);if(m){m.classList.remove('hidden');document.body.style.overflow='hidden';}}
    function closeAll(){document.querySelectorAll('[id^="modal-"]').forEach(function(m){m.classList.add('hidden');});document.body.style.overflow='';}
    document.addEventListener('click',function(e){
      var target = e.target as HTMLElement;
      var o = target.closest('[data-modal]') as HTMLElement | null;
      if(o){e.preventDefault();open(o.dataset.modal!);return;}
      var c = target.closest('[data-close]') || (target.classList && target.classList.contains('modal-backdrop')?target:null);
      if(c){e.preventDefault();closeAll();return;}
      var cl = target.closest('a[href="#contact"]');
      if(cl){e.preventDefault();open('choice');}
    });
    document.addEventListener('keydown',function(e){if(e.key==='Escape')closeAll();});
  })();
</script>
