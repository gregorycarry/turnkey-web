---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { useTranslations, getPathWithoutLang } from "../i18n/utils";
import { ui, defaultLang, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Overrides for pages whose URL slug differs by language (e.g. guides).
   *  Keys are language codes, values are site-relative paths like "/guia-trespasse". */
  langUrls?: Partial<Record<Lang, string>>;
  /** Overrides the default social-share image (e.g. a listing's own cover photo). Absolute URL. */
  ogImage?: string;
  ogImageAlt?: string;
}

const { lang, title, description, langUrls, ogImage, ogImageAlt } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t("meta.title");
const pageDescription = description ?? t("meta.description");
const htmlLang = t("htmlLang");
const shareImage = ogImage ?? "https://turnkey.pt/og-image.jpg";
const shareImageAlt = ogImageAlt ?? "TurnKey — Transmissions de commerces à Lisbonne";

// hreflang alternates — compute path without language prefix
const pathNoLang = getPathWithoutLang(Astro.url);
const buildAltUrl = (code: Lang) => {
  const base = "https://turnkey.pt";
  if (langUrls && langUrls[code]) return base + langUrls[code]!;
  if (code === defaultLang) return base + (pathNoLang === "/" ? "/" : pathNoLang);
  return `${base}/${code}${pathNoLang === "/" ? "" : pathNoLang}`;
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Grégory Vincent — TurnKey" />
    <meta name="theme-color" content="#F5762A" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{pageTitle}</title>

    <!-- hreflang alternates -->
    <link rel="alternate" hreflang="pt-PT" href={buildAltUrl("pt")} />
    <link rel="alternate" hreflang="fr" href={buildAltUrl("fr")} />
    <link rel="alternate" hreflang="en" href={buildAltUrl("en")} />
    <link rel="alternate" hreflang="x-default" href={buildAltUrl("pt")} />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="TurnKey" />
    <meta property="og:locale" content={lang === "pt" ? "pt_PT" : lang === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImage} />
  </head>
  <body>
    <Header lang={lang} langUrls={langUrls} />
    <main>
      <slot />
    </main>

    <div id="modal-lightbox" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4">
      <div class="modal-backdrop absolute inset-0 bg-black/90"></div>
      <button type="button" data-close aria-label={t("modal.close")} class="absolute top-4 right-5 text-white/80 hover:text-white text-4xl leading-none z-10">×</button>
      <button type="button" data-lightbox-prev aria-label="Previous" class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white text-5xl leading-none z-10 px-2 select-none">‹</button>
      <button type="button" data-lightbox-next aria-label="Next" class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white text-5xl leading-none z-10 px-2 select-none">›</button>
      <div class="relative max-w-5xl w-full max-h-[85vh] flex flex-col items-center">
        <img data-lightbox-img src="" alt="" class="max-w-full max-h-[75vh] object-contain rounded-md" />
        <p data-lightbox-counter class="text-white/70 text-sm mt-3"></p>
      </div>
    </div>

    <script>
      (function(){
        function open(id: string){closeAll();var m=document.getElementById('modal-'+id);if(m){m.classList.remove('hidden');document.body.style.overflow='hidden';}}
        function closeAll(){document.querySelectorAll('[id^="modal-"]').forEach(function(m){m.classList.add('hidden');});document.body.style.overflow='';}
        document.addEventListener('click',function(e){
          var target = e.target as HTMLElement;
          var o = target.closest('[data-modal]') as HTMLElement | null;
          if(o){e.preventDefault();open(o.dataset.modal!);return;}
          var c = target.closest('[data-close]') || (target.classList && target.classList.contains('modal-backdrop')?target:null);
          if(c){e.preventDefault();closeAll();return;}
          var cl = target.closest('a[href="#contact"]');
          if(cl){e.preventDefault();open('choice');}
        });
        document.addEventListener('keydown',function(e){if(e.key==='Escape')closeAll();});
      })();
    </script>

    <script>
      (function(){
        document.querySelectorAll('[data-carousel]').forEach(function(car){
          var slides = car.querySelectorAll('[data-slide]') as NodeListOf<HTMLElement>;
          if (slides.length <= 1) return;
          var idx = 0;
          setInterval(function(){
            slides[idx].style.opacity = '0';
            idx = (idx + 1) % slides.length;
            slides[idx].style.opacity = '1';
          }, 3500);
        });

        var lb = document.getElementById('modal-lightbox');
        var lbImg = lb ? (lb.querySelector('[data-lightbox-img]') as HTMLImageElement | null) : null;
        var lbCounter = lb ? lb.querySelector('[data-lightbox-counter]') : null;
        var lbImages: { src: string; alt: string }[] = [];
        var lbIndex = 0;

        function showLightboxImage(){
          if (!lbImg || !lbImages[lbIndex]) return;
          lbImg.src = lbImages[lbIndex].src;
          lbImg.alt = lbImages[lbIndex].alt;
          if (lbCounter) lbCounter.textContent = (lbIndex + 1) + ' / ' + lbImages.length;
        }

        function openLightbox(images: { src: string; alt: string }[], startIndex: number){
          if (!lb) return;
          lbImages = images;
          lbIndex = startIndex;
          showLightboxImage();
          document.querySelectorAll('[id^="modal-"]').forEach(function(m){ m.classList.add('hidden'); });
          lb.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }

        document.addEventListener('click', function(e){
          var target = e.target as HTMLElement;
          var car = target.closest('[data-carousel]') as HTMLElement | null;
          if (car) {
            if (!car.hasAttribute('data-lightbox')) return;
            var slides = car.querySelectorAll('[data-slide]') as NodeListOf<HTMLImageElement>;
            if (slides.length === 0) return;
            e.preventDefault();
            var images = Array.prototype.map.call(slides, function(s: HTMLImageElement){ return { src: s.src, alt: s.alt }; });
            openLightbox(images, 0);
            return;
          }
          if (target.closest('[data-lightbox-prev]')) {
            lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length;
            showLightboxImage();
            return;
          }
          if (target.closest('[data-lightbox-next]')) {
            lbIndex = (lbIndex + 1) % lbImages.length;
            showLightboxImage();
            return;
          }
        });

        document.addEventListener('keydown', function(e){
          if (!lb || lb.classList.contains('hidden')) return;
          if (e.key === 'ArrowLeft') { lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; showLightboxImage(); }
          if (e.key === 'ArrowRight') { lbIndex = (lbIndex + 1) % lbImages.length; showLightboxImage(); }
        });
      })();
    </script>

    <script is:inline>
      // Auto-detect browser language on first visit to any public page.
      // Rules:
      // - If user already picked a language (localStorage.tkLang), respect it.
      // - Else, read navigator.language. fr-* → /fr/ ; en-* → /en/ ; else stay PT.
      // - Only applies when the current page is the PT (default) version — avoids loops.
      // - Uses the page's own hreflang alternates when available (handles pages whose slug
      //   differs across languages, e.g. the Trespasse guide: guia-trespasse / guide-trespasse / trespasse-guide).
      (function () {
        try {
          var stored = localStorage.getItem("tkLang");
          var path = window.location.pathname;
          var isFr = path.startsWith("/fr/") || path === "/fr";
          var isEn = path.startsWith("/en/") || path === "/en";
          var currentLang = isFr ? "fr" : isEn ? "en" : "pt";

          function resolveTargetForLang(targetLang) {
            if (targetLang === currentLang) return null;
            var hreflangMap = { pt: "pt-PT", fr: "fr", en: "en" };
            var el = document.querySelector(
              'link[rel="alternate"][hreflang="' + hreflangMap[targetLang] + '"]'
            );
            if (el && el.href) {
              try {
                var u = new URL(el.href);
                return u.pathname + window.location.search + window.location.hash;
              } catch (e) {}
            }
            // Fallback: naive prefix (same-slug pages)
            if (targetLang === "pt") {
              return path + window.location.search + window.location.hash;
            }
            return "/" + targetLang + (path === "/" ? "" : path) + window.location.search + window.location.hash;
          }

          // Stored preference overrides when we're on the PT (default) page
          if (stored && stored !== currentLang && ["pt", "fr", "en"].indexOf(stored) !== -1) {
            if (currentLang === "pt") {
              var target = resolveTargetForLang(stored);
              if (target) window.location.replace(target);
              return;
            }
          }

          // First visit: auto-detect only on PT pages if nothing stored
          if (!stored && currentLang === "pt") {
            var nav = (navigator.language || "pt").toLowerCase();
            var detected = nav.indexOf("fr") === 0 ? "fr" : nav.indexOf("en") === 0 ? "en" : "pt";
            if (detected !== "pt") {
              localStorage.setItem("tkLang", detected);
              var target2 = resolveTargetForLang(detected);
              if (target2) window.location.replace(target2);
            }
          }
        } catch (e) {
          // localStorage may be blocked (private window) — fail silently
        }
      })();
    </script>
  </body>
</html>
