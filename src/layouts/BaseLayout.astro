---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { useTranslations, getPathWithoutLang } from "../i18n/utils";
import { ui, defaultLang, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t("meta.title");
const pageDescription = description ?? t("meta.description");
const htmlLang = t("htmlLang");

// hreflang alternates — compute path without language prefix
const pathNoLang = getPathWithoutLang(Astro.url);
const buildAltUrl = (code: Lang) => {
  const base = "https://turnkey.pt";
  if (code === defaultLang) return base + (pathNoLang === "/" ? "/" : pathNoLang);
  return `${base}/${code}${pathNoLang === "/" ? "" : pathNoLang}`;
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <link rel="alternate" hreflang="pt-PT" href={buildAltUrl("pt")} />
    <link rel="alternate" hreflang="fr" href={buildAltUrl("fr")} />
    <link rel="alternate" hreflang="en" href={buildAltUrl("en")} />
    <link rel="alternate" hreflang="x-default" href={buildAltUrl("pt")} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:locale" content={lang === "pt" ? "pt_PT" : lang === "fr" ? "fr_FR" : "en_US"} />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>

    <script is:inline>
      // Auto-detect browser language on first visit to any public page.
      // Rules:
      // - If user already picked a language (localStorage.tkLang), respect it.
      // - Else, read navigator.language. fr-* → /fr/ ; en-* → /en/ ; else stay PT.
      // - Only applies when the current page's language can be inferred to be PT (root path
      //   or no /fr /en prefix) to avoid redirect loops.
      (function () {
        try {
          var stored = localStorage.getItem("tkLang");
          var path = window.location.pathname;
          var isFr = path.startsWith("/fr/") || path === "/fr";
          var isEn = path.startsWith("/en/") || path === "/en";
          var currentLang = isFr ? "fr" : isEn ? "en" : "pt";

          // If stored preference exists, persist on nav and respect it
          if (stored && stored !== currentLang && ["pt", "fr", "en"].indexOf(stored) !== -1) {
            // Only redirect if we are on the PT version (default) and user prefers another
            if (currentLang === "pt") {
              var pathSansLang = path;
              var target = stored === "pt" ? pathSansLang : "/" + stored + (pathSansLang === "/" ? "" : pathSansLang);
              window.location.replace(target + window.location.search + window.location.hash);
              return;
            }
          }

          // First visit: auto-detect only on PT pages (default) if nothing stored
          if (!stored && currentLang === "pt") {
            var nav = (navigator.language || "pt").toLowerCase();
            var detected = nav.indexOf("fr") === 0 ? "fr" : nav.indexOf("en") === 0 ? "en" : "pt";
            if (detected !== "pt") {
              localStorage.setItem("tkLang", detected);
              var pathSansLang2 = path;
              var target2 = "/" + detected + (pathSansLang2 === "/" ? "" : pathSansLang2);
              window.location.replace(target2 + window.location.search + window.location.hash);
            }
          }
        } catch (e) {
          // localStorage may be blocked (private window) — fail silently
        }
      })();
    </script>
  </body>
</html>
