---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ListingDetail from "../../../components/ListingDetail.astro";
import { getListings, listingDetailUrls } from "../../../data/listings";

export async function getStaticPaths() {
  return getListings("en").map((listing) => ({ params: { code: listing.code } }));
}

const { code } = Astro.params;
const listing = getListings("en").find((l) => l.code === code)!;
const langUrls = listingDetailUrls(listing.code);
const title = `${listing.type} for Sale in ${listing.zone}, Lisbon | TurnKey`;
const description = `${listing.type} for sale in ${listing.zone}, Lisbon, Portugal.${listing.price ? ` Asking price ${listing.price}.` : ""} Business transfer (trespasse) handled by Grégory Vincent, TurnKey — IAD Portugal AMI 11220.`;
---

<BaseLayout lang="en" title={title} description={description} langUrls={langUrls} ogImage={listing.ogImage} ogImageAlt={listing.type}>
  <ListingDetail lang="en" listing={listing} />
</BaseLayout>
