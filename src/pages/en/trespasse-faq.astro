---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/guide.css";

const langUrls = {
  pt: "/faq-trespasse",
  fr: "/fr/faq-trespasse",
  en: "/en/trespasse-faq",
};

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": "Trespasse Lisbon — Frequently Asked Questions 2026",
  "url": "https://turnkey.pt/en/trespasse-faq",
  "inLanguage": "en",
  "publisher": {
    "@type": "Person",
    "name": "Grégory Vincent",
    "jobTitle": "Commercial Agent — Business Transfers",
    "url": "https://turnkey.pt/en/"
  },
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does a trespasse cost in Lisbon in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on sector and location. Ranges observed in central Lisbon: café/snack bar €40–120k, standard restaurant €80–250k, prime restaurant (Chiado, Príncipe Real, Alfama) €200–600k, salon/studio €25–90k, retail shop €15–100k. The trespasse price does not include the real estate value (only the going concern). Rent continues to be owed to the landlord."
      }
    },
    {
      "@type": "Question",
      "name": "Can you sell a trespasse at a loss?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The seller is free to set any price, including a symbolic €1 when the goal is simply to transfer the lease, employees and licence obligations. A sale below invested capital is common in business closures, divorces, or project changes. The gain or loss booked goes into the seller's tax return."
      }
    },
    {
      "@type": "Question",
      "name": "Can a trespasse fall through after the contrato-promessa is signed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, but rarely without consequence. If the buyer walks away without contractual grounds, they forfeit the deposit (typically 10% of the price). If the seller withdraws, they must return the deposit at double its amount (Art. 442.º Portuguese Civil Code). Typical conditions precedent that allow cancellation without penalty: documented bank financing refusal, incompatible lease assignment clause, non-transferable licence discovered during due diligence."
      }
    },
    {
      "@type": "Question",
      "name": "Who prepares the equipment and stock inventory?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The seller prepares the initial inventory and attaches it to the contrato-promessa — equipment (ovens, cold rooms, furniture), decor, consumables, stock as of signing date. The joint final inventory happens on the day of final signing, with both parties present: validation of assets, stock update to the real date, price adjustment if stock has varied by more than ±10% from the estimate."
      }
    },
    {
      "@type": "Question",
      "name": "Do you need a lawyer for a trespasse? A notary?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lawyer: strongly recommended for the buyer on deals above €100k, essential for lease and licence due diligence. Typical fees €1,500–4,000 for a standard deal. Notary: required only if the trespasse includes real property rights. For most trespasses (without purchasing the premises), a private deed with notarised signatures is sufficient."
      }
    },
    {
      "@type": "Question",
      "name": "How far can you negotiate the price of a trespasse?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In Lisbon, the average gap between asking price and final signing price is 8 to 18% on a standard deal. Beyond that requires concrete justification: upcoming works (end-of-life equipment, ASAE compliance), heavy employee liabilities, imminent rent review, documentation gaps. In very tight markets (restaurants in Chiado or Príncipe Real) the gap can fall to 0–5%, or even over-asking sales."
      }
    },
    {
      "@type": "Question",
      "name": "How long should the seller stay on for handover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard practice: 2 to 4 weeks of presence by the seller after takeover, either gratis or paid (to be defined in the contract). This covers transferring supplier relationships, training the team on existing processes, introducing key clients. On more technical deals (artisan bakery, niche kitchen) it can extend to 2–3 months. Standard non-compete clause: 2 years, 1 km radius."
      }
    },
    {
      "@type": "Question",
      "name": "Can ASAE refuse to transfer a licence?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, in some cases. Licences tied to the premises (closing hours, terrace authorisation, alcohol licence) typically transfer if the space continues to be used for the same activity. Personal licences (pharmacy technical director, hairdresser professional card) must be obtained by the new operator. If the use of the premises changes (e.g. café to bar with live music), ASAE can require a new licence and a new application, with a 3–6 month timeline."
      }
    },
    {
      "@type": "Question",
      "name": "How do you check whether a commercial lease allows a trespasse?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Request a full copy of the lease agreement (including addenda and rent updates) before any offer. Look for clauses mentioning 'trespasse', 'cessão', 'transmissão' or 'sublease'. In recent leases (post-NRAU 2006), trespasse is generally free. In older leases (pre-1990) there may be restrictions or a required landlord authorisation. If in doubt: get a Portuguese commercial real estate lawyer's opinion before the promissory contract."
      }
    },
    {
      "@type": "Question",
      "name": "What if the landlord contests the trespasse notification?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The notification is sent by registered letter with return receipt within 15 days of signing. The landlord then has 30 days to exercise their right of pre-emption (buying the going concern on the same terms) or to contest — for example if the lease forbids assignment. If they contest without valid grounds, proceed with normal execution and legal support: the trespasse remains valid between the parties, even if a landlord dispute is pending."
      }
    }
  ]
});
---

<BaseLayout
  lang="en"
  title="Trespasse FAQ in Lisbon — 10 Practical Questions 2026 | TurnKey"
  description="The 10 practical questions buyers and sellers ask before a trespasse in Lisbon: price, negotiation, inventory, ASAE licences, lease, handover. Direct 2026 answers."
  langUrls={langUrls}
  schema={faqSchema}
>
  <div class="guide-page">
    <div class="page-wrap">
      <article>
        <p class="eyebrow">FAQ · Trespasse Lisbon · 2026</p>
        <h1>10 practical questions about the trespasse in Lisbon</h1>

        <div class="byline">
          <div class="byline-avatar">G</div>
          <div>
            <div class="byline-name">Grégory Vincent</div>
            <div class="byline-role">IAD Portugal Commercial Agent · AMI 11220</div>
          </div>
          <span class="byline-read">7 min read</span>
        </div>

        <p class="lead">
          The practical questions I get every week from Lisbon buyers and sellers — with direct answers, 2026 figures and the legal references when they apply.
          Companion to the <a href="/en/trespasse-guide" style="color:var(--g-accent);font-weight:600;">complete trespasse guide</a>.
        </p>

        <div class="faq">
          <div class="faq-item" id="q1">
            <div class="faq-q">1. How much does a trespasse cost in Lisbon in 2026?</div>
            <p class="faq-a">
              It depends on sector and location. Ranges observed in central Lisbon:
              <strong>café / snack bar</strong> €40–120k,
              <strong>standard restaurant</strong> €80–250k,
              <strong>prime restaurant</strong> (Chiado, Príncipe Real, Alfama) €200–600k,
              <strong>salon / studio</strong> €25–90k,
              <strong>retail shop</strong> €15–100k.
              The trespasse price does not include the real estate value (only the going concern). Rent continues to be owed to the landlord.
            </p>
          </div>

          <div class="faq-item" id="q2">
            <div class="faq-q">2. Can you sell a trespasse at a loss?</div>
            <p class="faq-a">
              Yes. The seller is free to set any price, including a symbolic €1 when the goal is simply to transfer the lease, employees and licence obligations. A sale below invested capital is common in business closures, divorces, or project changes. The gain or loss booked goes into the seller's tax return.
            </p>
          </div>

          <div class="faq-item" id="q3">
            <div class="faq-q">3. Can a trespasse fall through after the contrato-promessa is signed?</div>
            <p class="faq-a">
              Yes, but rarely without consequence. If the <strong>buyer</strong> walks away without contractual grounds, they forfeit the deposit (typically 10% of the price). If the <strong>seller</strong> withdraws, they must return the deposit at double its amount (Art. 442.º Portuguese Civil Code). Typical conditions precedent that allow cancellation without penalty: documented bank financing refusal, incompatible lease assignment clause, non-transferable licence discovered during due diligence.
            </p>
          </div>

          <div class="faq-item" id="q4">
            <div class="faq-q">4. Who prepares the equipment and stock inventory?</div>
            <p class="faq-a">
              The <strong>seller prepares the initial inventory</strong> and attaches it to the contrato-promessa — equipment (ovens, cold rooms, furniture), decor, consumables, stock as of signing date. The <strong>joint final inventory</strong> happens on the day of final signing, with both parties present: validation of assets, stock update to the real date, price adjustment if stock has varied by more than ±10% from the estimate.
            </p>
          </div>

          <div class="faq-item" id="q5">
            <div class="faq-q">5. Do you need a lawyer for a trespasse? A notary?</div>
            <p class="faq-a">
              <strong>Lawyer</strong>: strongly recommended for the buyer on deals above €100k, essential for lease and licence due diligence. Typical fees €1,500–4,000 for a standard deal.
              <strong>Notary</strong>: required only if the trespasse includes real property rights. For most trespasses (without purchasing the premises), a private deed with notarised signatures is sufficient.
            </p>
          </div>

          <div class="faq-item" id="q6">
            <div class="faq-q">6. How far can you negotiate the price of a trespasse?</div>
            <p class="faq-a">
              In Lisbon, the average gap between asking price and final signing price is <strong>8 to 18%</strong> on a standard deal. Beyond that requires concrete justification: upcoming works (end-of-life equipment, ASAE compliance), heavy employee liabilities, imminent rent review, documentation gaps. In very tight markets (restaurants in Chiado or Príncipe Real) the gap can fall to 0–5%, or even over-asking sales.
            </p>
          </div>

          <div class="faq-item" id="q7">
            <div class="faq-q">7. How long should the seller stay on for handover?</div>
            <p class="faq-a">
              Standard practice: <strong>2 to 4 weeks of presence</strong> by the seller after takeover, either gratis or paid (to be defined in the contract). This covers transferring supplier relationships, training the team on existing processes, introducing key clients. On more technical deals (artisan bakery, niche kitchen) it can extend to 2–3 months. Standard non-compete clause: 2 years, 1 km radius.
            </p>
          </div>

          <div class="faq-item" id="q8">
            <div class="faq-q">8. Can ASAE refuse to transfer a licence?</div>
            <p class="faq-a">
              Yes, in some cases. Licences tied to the <strong>premises</strong> (closing hours, terrace authorisation, alcohol licence) typically transfer if the space continues to be used for the same activity. <strong>Personal</strong> licences (pharmacy technical director, hairdresser professional card) must be obtained by the new operator. If the use of the premises changes (e.g. café → bar with live music), ASAE can require a new licence and a new application (3–6 month timeline).
            </p>
          </div>

          <div class="faq-item" id="q9">
            <div class="faq-q">9. How do you check whether a commercial lease allows a trespasse?</div>
            <p class="faq-a">
              Request a full copy of the <strong>lease agreement</strong> (including addenda and rent updates) before any offer. Look for clauses mentioning "trespasse", "cessão", "transmissão" or "sublease". In recent leases (post-NRAU 2006), trespasse is generally free. In older leases (pre-1990) there may be restrictions or a required landlord authorisation. If in doubt: get a Portuguese commercial real estate lawyer's opinion before the promissory contract.
            </p>
          </div>

          <div class="faq-item" id="q10">
            <div class="faq-q">10. What if the landlord contests the trespasse notification?</div>
            <p class="faq-a">
              The notification is sent by <strong>registered letter with return receipt</strong> within 15 days of signing. The landlord then has 30 days to exercise their <strong>right of pre-emption</strong> (buying the going concern on the same terms) or to contest — for example if the lease forbids assignment. If they contest without valid grounds, proceed with normal execution and legal support: the trespasse remains valid between the parties, even if a landlord dispute is pending.
            </p>
          </div>
        </div>

        <div class="cta">
          <h2>Another question about your deal?</h2>
          <p>First conversation is free and confidential — by phone or WhatsApp. No commitment.</p>
          <div class="cta-who">
            <div class="cta-avatar">G</div>
            <div>
              <div class="cta-name">Grégory Vincent</div>
              <div class="cta-title">IAD Portugal Commercial Agent · AMI 11220 · turnkey.pt</div>
            </div>
          </div>
          <div class="btn-group">
            <a class="btn" href="https://wa.me/351962350026" target="_blank" rel="noopener">WhatsApp</a>
            <a class="btn btn-secondary" href="tel:+351962350026">+351 962 350 026</a>
            <a class="btn btn-secondary" href="/en/trespasse-guide">Complete guide</a>
          </div>
        </div>
      </article>

      <aside class="sidebar">
        <nav class="toc">
          <div class="toc-label">The 10 questions</div>
          <ol>
            <li><a href="#q1">How much does it cost?</a></li>
            <li><a href="#q2">Sell at a loss?</a></li>
            <li><a href="#q3">Failure after promessa?</a></li>
            <li><a href="#q4">Who does the inventory?</a></li>
            <li><a href="#q5">Lawyer and notary?</a></li>
            <li><a href="#q6">Negotiation margin?</a></li>
            <li><a href="#q7">Handover period?</a></li>
            <li><a href="#q8">ASAE can refuse?</a></li>
            <li><a href="#q9">Lease transferable?</a></li>
            <li><a href="#q10">Landlord contests?</a></li>
          </ol>
        </nav>
        <div class="sidebar-contact">
          <strong>Questions?</strong>
          Grégory Vincent<br />
          Business transfer specialist<br />
          <span class="sidebar-tel">+351 962 350 026</span>
          <a href="mailto:gregory.vincent@iadportugal.pt">gregory.vincent@iadportugal.pt</a>
        </div>
      </aside>
    </div>

    <p class="guide-disclaimer">
      This FAQ is provided for informational purposes only and does not constitute legal, tax or financial advice.
      Consult a qualified professional before any transaction. © TurnKey 2026.
    </p>
  </div>
</BaseLayout>
