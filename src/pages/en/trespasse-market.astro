---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/guide.css";

const langUrls = {
  pt: "/mercado-trespasse",
  fr: "/fr/marche-trespasse",
  en: "/en/trespasse-market",
};
---

<BaseLayout
  lang="en"
  title="Trespasse Market in Lisbon — Data by Neighbourhood 2026 | TurnKey"
  description="Trespasse market data for Lisbon by neighbourhood in 2026: Chiado, Baixa, Príncipe Real, Cais do Sodré, Bairro Alto, Alfama, Estrela, Graça, Marvila, Parque das Nações. Commercial rents and trespasse prices by sector."
  langUrls={langUrls}
>
  <div class="guide-page">
    <div class="page-wrap">
      <article>
        <p class="eyebrow">Market Data · Lisbon · 2026</p>
        <h1>Trespasse market in Lisbon:<br />data by neighbourhood in 2026</h1>

        <div class="byline">
          <div class="byline-avatar">G</div>
          <div>
            <div class="byline-name">Grégory Vincent</div>
            <div class="byline-role">Commercial Agent · Licensed AMI brokerage</div>
          </div>
          <span class="byline-read">10 min read</span>
        </div>

        <p class="lead">
          Overview of the 10 most active Lisbon neighbourhoods for trespasse transactions in 2026: positioning, average commercial rent, price ranges by sector, current dynamics, and typical buyer profile. Data compiled from my active mandates and from publicly observable listings (Idealista, Imovirtual, Custojusto).
        </p>

        <div class="hl">
          <p><strong>How to read this data:</strong> commercial rents in €/m²/month for a ground-floor unit. Trespasse prices in €k excluding real estate (going concern only). 2026 ranges based on real deals; each case has its own specifics.</p>
        </div>

        <h2 id="chiado">1. Chiado</h2>
        <div class="neighborhood-grid">
          <div class="neighborhood-card">
            <h3>Chiado <span class="nbh-badge prime">Hyper prime</span></h3>
            <p class="nbh-tagline">Lisbon's retail showcase, peak tourist flow, record-high rents.</p>
            <div class="nbh-metrics">
              <div class="nbh-metric">Commercial rent<strong>€45–90 /m²/month</strong></div>
              <div class="nbh-metric">Café / snack bar<strong>€80–180k</strong></div>
              <div class="nbh-metric">Prime restaurant<strong>€300–700k</strong></div>
              <div class="nbh-metric">Retail shop<strong>€60–200k</strong></div>
            </div>
            <p class="nbh-note"><strong>Dynamics:</strong> high tension, low turnover, prices stable upward. <strong>Buyer:</strong> international groups, retail chains, family offices.</p>
          </div>
        </div>

        <h2 id="baixa">2. Baixa</h2>
        <div class="neighborhood-grid">
          <div class="neighborhood-card">
            <h3>Baixa <span class="nbh-badge prime">Prime tourist</span></h3>
            <p class="nbh-tagline">Historic centre, continuous tourist flow, opportunities on secondary streets.</p>
            <div class="nbh-metrics">
              <div class="nbh-metric">Commercial rent<strong>€30–60 /m²/month</strong></div>
              <div class="nbh-metric">Café / restaurant<strong>€60–180k</strong></div>
              <div class="nbh-metric">Prime restaurant<strong>€200–500k</strong></div>
              <div class="nbh-metric">Retail shop<strong>€40–150k</strong></div>
            </div>
            <p class="nbh-note"><strong>Dynamics:</strong> saturation on main streets (Augusta, da Prata), opportunities on cross-streets. <strong>Buyer:</strong> tourist-concept operators, souvenir/gastronomy retail.</p>
          </div>
        </div>

        <h2 id="principe-real">3. Príncipe Real</h2>
        <div class="neighborhood-grid">
          <div class="neighborhood-card">
            <h3>Príncipe Real <span class="nbh-badge prime">Prime upscale</span></h3>
            <p class="nbh-tagline">Lisbon's gastronomic hotspot, high-spending expat clientele.</p>
            <div class="nbh-metrics">
              <div class="nbh-metric">Commercial rent<strong>€35–65 /m²/month</strong></div>
              <div class="nbh-metric">Café / restaurant<strong>€100–250k</strong></div>
              <div class="nbh-metric">Prime restaurant<strong>€250–550k</strong></div>
              <div class="nbh-metric">Concept retail<strong>€50–180k</strong></div>
            </div>
            <p class="nbh-note"><strong>Dynamics:</strong> demand well above supply, prices rising steadily. <strong>Buyer:</strong> strong-concept operators (signature café, concept store), expat investors.</p>
          </div>
        </div>

        <h2 id="cais-sodre">4. Cais do Sodré</h2>
        <div class="neighborhood-grid">
          <div class="neighborhood-card">
            <h3>Cais do Sodré <span class="nbh-badge prime">Prime nightlife</span></h3>
            <p class="nbh-tagline">Lisbon's nightlife district, bar / club / late-night restaurant focus.</p>
            <div class="nbh-metrics">
              <div class="nbh-metric">Commercial rent<strong>€30–55 /m²/month</strong></div>
              <div class="nbh-metric">Bar / lounge<strong>€100–300k</strong></div>
              <div class="nbh-metric">Late-night restaurant<strong>€150–400k</strong></div>
              <div class="nbh-metric">Club<strong>€200–600k</strong></div>
            </div>
            <p class="nbh-note"><strong>Dynamics:</strong> selective market, heavy dependence on the licence (late-hour permit = strong added value). <strong>Buyer:</strong> established nightlife groups, experienced operators.</p>
          </div>
        </div>

        <h2 id="bairro-alto">5. Bairro Alto</h2>
        <div class="neighborhood-grid">
          <div class="neighborhood-card">
            <h3>Bairro Alto <span class="nbh-badge">Established nightlife</span></h3>
            <p class="nbh-tagline">Historic bohemia, high F&amp;B density, prices more affordable than Chiado.</p>
            <div class="nbh-metrics">
              <div class="nbh-metric">Commercial rent<strong>€22–40 /m²/month</strong></div>
              <div class="nbh-metric">Bar<strong>€50–150k</strong></div>
              <div class="nbh-metric">Restaurant<strong>€80–220k</strong></div>
              <div class="nbh-metric">Atypical shop<strong>€25–80k</strong></div>
            </div>
            <p class="nbh-note"><strong>Dynamics:</strong> high turnover, opportunities for first-time trespasse buyers. <strong>Buyer:</strong> first acquirers, independent operators.</p>
          </div>
        </div>

        <h2 id="alfama">6. Alfama</h2>
        <div class="neighborhood-grid">
          <div class="neighborhood-card">
            <h3>Alfama <span class="nbh-badge prime">Prime tourist</span></h3>
            <p class="nbh-tagline">Historic neighbourhood, dense tourist flow, fado / traditional focus.</p>
            <div class="nbh-metrics">
              <div class="nbh-metric">Commercial rent<strong>€25–50 /m²/month</strong></div>
              <div class="nbh-metric">Tavern / tasca<strong>€60–180k</strong></div>
              <div class="nbh-metric">Fado house<strong>€150–400k</strong></div>
              <div class="nbh-metric">Souvenir retail<strong>€30–100k</strong></div>
            </div>
            <p class="nbh-note"><strong>Dynamics:</strong> stable market, sensitive licensing (noise / hours restrictions). <strong>Buyer:</strong> restaurant families, tourist groups, hoteliers with F&amp;B extensions.</p>
          </div>
        </div>

        <h2 id="estrela-lapa">7. Estrela / Lapa</h2>
        <div class="neighborhood-grid">
          <div class="neighborhood-card">
            <h3>Estrela / Lapa <span class="nbh-badge">Upscale residential</span></h3>
            <p class="nbh-tagline">Upscale residential area, loyal local clientele, daytime pace.</p>
            <div class="nbh-metrics">
              <div class="nbh-metric">Commercial rent<strong>€18–35 /m²/month</strong></div>
              <div class="nbh-metric">Café / brunch<strong>€40–150k</strong></div>
              <div class="nbh-metric">Neighbourhood restaurant<strong>€80–220k</strong></div>
              <div class="nbh-metric">Salon / studio<strong>€30–100k</strong></div>
            </div>
            <p class="nbh-note"><strong>Dynamics:</strong> stable market, proximity-driven demand. <strong>Buyer:</strong> local operators, lifestyle projects (relocating expats), family investors.</p>
          </div>
        </div>

        <h2 id="graca">8. Graça</h2>
        <div class="neighborhood-grid">
          <div class="neighborhood-card">
            <h3>Graça <span class="nbh-badge">Emerging</span></h3>
            <p class="nbh-tagline">Neighbourhood in full transformation, still affordable prices, creative dynamics.</p>
            <div class="nbh-metrics">
              <div class="nbh-metric">Commercial rent<strong>€15–28 /m²/month</strong></div>
              <div class="nbh-metric">Café / snack<strong>€25–90k</strong></div>
              <div class="nbh-metric">Restaurant<strong>€50–150k</strong></div>
              <div class="nbh-metric">Creative shop<strong>€15–60k</strong></div>
            </div>
            <p class="nbh-note"><strong>Dynamics:</strong> gentrification underway, good upside potential. <strong>Buyer:</strong> first acquirers, concept projects, margin-seeking operators.</p>
          </div>
        </div>

        <h2 id="marvila">9. Marvila</h2>
        <div class="neighborhood-grid">
          <div class="neighborhood-card">
            <h3>Marvila <span class="nbh-badge">Emerging creative</span></h3>
            <p class="nbh-tagline">Former industrial zone reconverted, atypical spaces, breweries and canteens.</p>
            <div class="nbh-metrics">
              <div class="nbh-metric">Commercial rent<strong>€10–22 /m²/month</strong></div>
              <div class="nbh-metric">Café / canteen<strong>€30–100k</strong></div>
              <div class="nbh-metric">Brewery / tap room<strong>€80–250k</strong></div>
              <div class="nbh-metric">Atypical space<strong>Case by case</strong></div>
            </div>
            <p class="nbh-note"><strong>Dynamics:</strong> mid-term bet, appeal to the creative generation. <strong>Buyer:</strong> concept operators, breweries, coworking spaces with F&amp;B.</p>
          </div>
        </div>

        <h2 id="parque-nacoes">10. Parque das Nações</h2>
        <div class="neighborhood-grid">
          <div class="neighborhood-card">
            <h3>Parque das Nações <span class="nbh-badge">Business / modern</span></h3>
            <p class="nbh-tagline">Office and family zone, business clientele on weekdays, family on weekends.</p>
            <div class="nbh-metrics">
              <div class="nbh-metric">Commercial rent<strong>€18–35 /m²/month</strong></div>
              <div class="nbh-metric">Business café / restaurant<strong>€60–200k</strong></div>
              <div class="nbh-metric">Family restaurant<strong>€80–250k</strong></div>
              <div class="nbh-metric">Service / salon<strong>€40–120k</strong></div>
            </div>
            <p class="nbh-note"><strong>Dynamics:</strong> mature market, predictable footfall, lower turnover. <strong>Buyer:</strong> restaurant chains, operators with industrialised format.</p>
          </div>
        </div>

        <h2 id="synthese">Summary table</h2>

        <div class="data-table-wrap">
          <table class="data-table">
            <thead>
              <tr><th>Neighbourhood</th><th>Rent €/m²/month</th><th>Avg. restaurant trespasse</th></tr>
            </thead>
            <tbody>
              <tr><td>Chiado</td><td class="accent-cell">45–90</td><td>€300–700k</td></tr>
              <tr><td>Baixa</td><td class="accent-cell">30–60</td><td>€200–500k</td></tr>
              <tr><td>Príncipe Real</td><td class="accent-cell">35–65</td><td>€250–550k</td></tr>
              <tr><td>Cais do Sodré</td><td class="accent-cell">30–55</td><td>€150–400k</td></tr>
              <tr><td>Bairro Alto</td><td class="accent-cell">22–40</td><td>€80–220k</td></tr>
              <tr><td>Alfama</td><td class="accent-cell">25–50</td><td>€60–400k</td></tr>
              <tr><td>Estrela / Lapa</td><td class="accent-cell">18–35</td><td>€80–220k</td></tr>
              <tr><td>Graça</td><td class="accent-cell">15–28</td><td>€50–150k</td></tr>
              <tr><td>Marvila</td><td class="accent-cell">10–22</td><td>€30–250k</td></tr>
              <tr><td>Parque das Nações</td><td class="accent-cell">18–35</td><td>€80–250k</td></tr>
            </tbody>
          </table>
        </div>

        <p class="fiscal-note">This data is indicative. For a precise valuation of your neighbourhood or deal, contact me directly.</p>

        <div class="cta">
          <h2>Buying or selling in this market?</h2>
