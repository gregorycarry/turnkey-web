---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ListingDetail from "../../../components/ListingDetail.astro";
import { getListings, listingDetailUrls } from "../../../data/listings";

export async function getStaticPaths() {
  return getListings("fr").map((listing) => ({ params: { code: listing.code } }));
}

const { code } = Astro.params;
const listing = getListings("fr").find((l) => l.code === code)!;
const langUrls = listingDetailUrls(listing.code);
const title = `${listing.type} — ${listing.zone} | TurnKey`;
const description = `${listing.type} à ${listing.zone}. Mandat TurnKey, trespasse accompagné par Grégory Vincent, IAD Portugal AMI 11220.`;
---

<BaseLayout lang="fr" title={title} description={description} langUrls={langUrls} ogImage={listing.ogImage} ogImageAlt={listing.type}>
  <ListingDetail lang="fr" listing={listing} />
</BaseLayout>
