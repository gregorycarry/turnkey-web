---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="TurnKey — Transmissão de comércios em Lisboa">
  <!-- Hero -->
  <section class="min-h-screen flex flex-col items-center justify-center bg-[var(--color-cream)] px-6 text-center">
    <p class="text-sm font-semibold tracking-widest text-[var(--color-orange)] uppercase mb-6">
      IAD Portugal — AMI 11220
    </p>

    <h1 class="text-6xl md:text-8xl font-extrabold text-[var(--color-anthracite)] mb-6">
      Turn<span class="text-[var(--color-orange)]">Key</span>
    </h1>

    <p class="text-xl md:text-2xl text-[var(--color-anthracite)] max-w-2xl">
      Where businesses change hands, not value.
    </p>

    <div class="mt-12 flex flex-col sm:flex-row gap-4">
      <a href="#properties" class="bg-[var(--color-orange)] text-white px-8 py-3 rounded-md font-semibold hover:opacity-90 transition">
        Voir les mandats
      </a>
      <a href="#contact" class="border-2 border-[var(--color-anthracite)] text-[var(--color-anthracite)] px-8 py-3 rounded-md font-semibold hover:bg-[var(--color-anthracite)] hover:text-white transition">
        Prendre contact
      </a>
    </div>
  </section>
</BaseLayout>