---
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = [
  { icon: "🍽️", label: "F&B", sub: "Café · Restaurant · Bar · Hôtel" },
  { icon: "🛍️", label: "Commerces", sub: "Salon · Boutique · Bureau" },
  { icon: "✨", label: "Atypique", sub: "Espace singulier" }
];

const mandats = [
  {
    code: "TK-2026-001",
    type: "Restaurant / Café",
    zone: "Axe Estrela / Lapa",
    prix: "100–150 k€",
    ca: "250–290 k€",
    motif: "Réorientation professionnelle",
    forces: ["Licences complètes", "Terrasse calme", "Quartier en plein dynamisme", "Potentiel de développement"]
  }
];
---

<BaseLayout title="TurnKey — Transmissão de comércios em Lisboa">

  <!-- HERO -->
  <section class="relative min-h-[calc(100vh-80px)] flex flex-col items-center justify-center px-6 text-center py-20 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/hero-bg.jpg');"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-anthracite)]/70 via-[var(--color-anthracite)]/60 to-[var(--color-anthracite)]/80"></div>
    <div class="relative z-10 flex flex-col items-center max-w-4xl">
      <p class="text-sm font-semibold tracking-widest text-[var(--color-orange)] uppercase mb-0">
        IAD Portugal — AMI 11220
      </p>
      <h1 class="font-black text-white tracking-tight text-center [font-family:'Playfair_Display',serif]" style="font-size: clamp(4rem, 14vw, 10rem); line-height: 0.9; letter-spacing: -0.03em;">Turn<span class="text-[var(--color-orange)]">Key</span></h1>
      <h1 class="text-xl md:text-2xl font-medium text-white max-w-3xl leading-relaxed mt-16">
        Restaurateur et broker à Lisbonne. Je vends et j'accompagne les repreneurs de commerces.
      </h1>
      <p class="text-lg text-white/80 mt-6 max-w-2xl">
        Where businesses change hands, not value.
      </p>
      <div class="mt-12 flex flex-col sm:flex-row gap-4">
        <button type="button" data-modal="seller" class="bg-[var(--color-orange)] text-white px-8 py-4 rounded-md font-semibold hover:opacity-90 transition">
          Je veux vendre mon commerce
        </button>
        <button type="button" data-modal="buyer" class="bg-white/15 backdrop-blur-sm border-2 border-white text-white px-8 py-4 rounded-md font-semibold hover:bg-white hover:text-[var(--color-anthracite)] transition">
          Je cherche à reprendre
        </button>
      </div>
    </div>
  </section>

  <!-- DOUBLE PARCOURS -->
  <section class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-sm font-semibold tracking-widest text-[var(--color-orange)] uppercase mb-3">Deux missions, une expertise</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-anthracite)]">Vendre ou reprendre, je vous accompagne</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div id="seller" class="bg-[var(--color-cream)] p-10 rounded-lg border-t-4 border-[var(--color-orange)]">
          <h3 class="text-2xl font-bold text-[var(--color-anthracite)] mb-4">Vous vendez votre commerce</h3>
          <p class="text-[var(--color-anthracite)]/80 mb-6 leading-relaxed">
            Restaurant, café, salon, boutique — je valorise votre fonds, je le protège par la confidentialité, et je le présente aux repreneurs qualifiés de ma base.
          </p>
          <ul class="space-y-3 mb-8 text-[var(--color-anthracite)]/80">
            <li class="flex gap-3"><span class="text-[var(--color-orange)] font-bold">✓</span> Valorisation gratuite et confidentielle</li>
            <li class="flex gap-3"><span class="text-[var(--color-orange)] font-bold">✓</span> Teasers aveugles, jamais votre enseigne exposée</li>
            <li class="flex gap-3"><span class="text-[var(--color-orange)] font-bold">✓</span> Objectif : 45 jours entre mandat et signature</li>
            <li class="flex gap-3"><span class="text-[var(--color-orange)] font-bold">✓</span> Accompagnement notaire et bail commercial</li>
          </ul>
          <button type="button" data-modal="seller" class="inline-block bg-[var(--color-orange)] text-white px-6 py-3 rounded-md font-semibold hover:opacity-90 transition">
            Estimer mon commerce
          </button>
        </div>
        <div id="buyer" class="bg-[var(--color-cream)] p-10 rounded-lg border-t-4 border-[var(--color-anthracite)]">
          <h3 class="text-2xl font-bold text-[var(--color-anthracite)] mb-4">Vous cherchez à reprendre</h3>
          <p class="text-[var(--color-anthracite)]/80 mb-6 leading-relaxed">
            Vous voulez racheter un fonds de commerce à Lisbonne ? Je vous fais gagner des mois : dossiers vérifiés, cédants sérieux, négociation encadrée.
          </p>
          <ul class="space-y-3 mb-8 text-[var(--color-anthracite)]/80">
            <li class="flex gap-3"><span class="text-[var(--color-anthracite)] font-bold">✓</span> Accès prioritaire aux mandats en cours</li>
            <li class="flex gap-3"><span class="text-[var(--color-anthracite)] font-bold">✓</span> Analyse des chiffres et due diligence</li>
            <li class="flex gap-3"><span class="text-[var(--color-anthracite)] font-bold">✓</span> Vision opérateur — je fais tourner un café moi-même</li>
            <li class="flex gap-3"><span class="text-[var(--color-anthracite)] font-bold">✓</span> Négociation prix et conditions</li>
          </ul>
          <button type="button" data-modal="buyer" class="inline-block bg-[var(--color-anthracite)] text-white px-6 py-3 rounded-md font-semibold hover:opacity-90 transition">
            Rejoindre la base repreneurs
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- MANDATS EN COURS -->
  <section id="properties" class="py-24 px-6 bg-[var(--color-cream)]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-sm font-semibold tracking-widest text-[var(--color-orange)] uppercase mb-3">Portfolio</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-anthracite)]">Mandats en cours</h2>
        <p class="text-lg text-[var(--color-anthracite)]/70 mt-4 max-w-2xl mx-auto">
          Nos dossiers sont présentés en aveugle. Détails complets après signature d'un NDA.
        </p>
      </div>

      <!-- Grille catégories -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        {categories.map((cat) => (
          <button class="flex flex-col items-center gap-3 p-8 bg-white rounded-lg border border-gray-100 hover:border-[var(--color-orange)] hover:shadow-md transition">
            <span class="text-5xl">{cat.icon}</span>
            <span class="text-lg font-bold text-[var(--color-anthracite)]">{cat.label}</span>
            <span class="text-xs text-[var(--color-anthracite)]/60 text-center">{cat.sub}</span>
          </button>
        ))}
      </div>

      <!-- Cartes mandats -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {mandats.map((m) => (
          <article class="bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-xl transition">
            <div class="h-48 bg-gradient-to-br from-[var(--color-anthracite)] to-[var(--color-orange)]/60 flex items-center justify-center">
              <span class="text-white text-6xl opacity-30">🏪</span>
            </div>
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-mono font-semibold text-[var(--color-anthracite)]/60">{m.code}</span>
                <span class="text-xs font-semibold bg-[var(--color-orange)]/10 text-[var(--color-orange)] px-2 py-1 rounded">En vente</span>
              </div>
              <h3 class="text-xl font-bold text-[var(--color-anthracite)] mb-1">{m.type}</h3>
              <p class="text-sm text-[var(--color-anthracite)]/60 mb-4">{m.zone}</p>
              <div class="grid grid-cols-2 gap-3 mb-4 py-4 border-y border-gray-100">
                <div>
                  <p class="text-xs text-[var(--color-anthracite)]/60 uppercase tracking-wider">Prix</p>
                  <p class="text-sm font-bold text-[var(--color-anthracite)]">{m.prix}</p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-anthracite)]/60 uppercase tracking-wider">CA annuel</p>
                  <p class="text-sm font-bold text-[var(--color-anthracite)]">{m.ca}</p>
                </div>
              </div>
              <div class="mb-4">
                <p class="text-xs text-[var(--color-anthracite)]/60 uppercase tracking-wider mb-2">Points forts</p>
                <div class="flex flex-wrap gap-2">
                  {m.forces.map((f) => (
                    <span class="text-xs bg-[var(--color-cream)] text-[var(--color-anthracite)] px-2 py-1 rounded">{f}</span>
                  ))}
                </div>
              </div>
              <p class="text-xs text-[var(--color-anthracite)]/60 italic mb-4">Motif : {m.motif}</p>
              <button type="button" data-modal="buyer" class="block text-center w-full bg-[var(--color-anthracite)] text-white py-3 rounded-md font-semibold hover:bg-[var(--color-orange)] transition">
                Demander le dossier
              </button>
            </div>
          </article>
        ))}

        <!-- Bloc CTA base repreneurs -->
        <article class="bg-[var(--color-anthracite)] text-white rounded-lg p-8 flex flex-col justify-center items-center text-center">
          <span class="text-4xl mb-4">🔔</span>
          <h3 class="text-xl font-bold mb-3">Pas encore le bon dossier ?</h3>
          <p class="text-white/70 mb-6 text-sm">Rejoignez la base repreneurs et soyez notifié en priorité dès qu'un nouveau mandat correspond à votre recherche.</p>
          <button type="button" data-modal="buyer" class="inline-block bg-[var(--color-orange)] text-white px-6 py-3 rounded-md font-semibold hover:opacity-90 transition">
            Rejoindre la base
          </button>
        </article>
      </div>
    </div>
  </section>

  <!-- POURQUOI TURNKEY -->
  <section class="py-24 px-6 bg-[var(--color-anthracite)] text-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-sm font-semibold tracking-widest text-[var(--color-orange)] uppercase mb-3">Pourquoi TurnKey</p>
        <h2 class="text-3xl md:text-4xl font-bold">La différence entre un agent et un broker qui connaît le métier</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <div class="text-4xl font-bold text-[var(--color-orange)] mb-4">01</div>
          <h3 class="text-xl font-bold mb-3">Restaurateur avant broker</h3>
          <p class="text-white/70 leading-relaxed">Je gère APF Café à Lapa. Je connais les coûts, les marges, les pièges — et je le sens quand un dossier tient la route.</p>
        </div>
        <div>
          <div class="text-4xl font-bold text-[var(--color-orange)] mb-4">02</div>
          <h3 class="text-xl font-bold mb-3">Confidentialité intégrale</h3>
          <p class="text-white/70 leading-relaxed">Jamais votre enseigne, jamais votre adresse. Teasers aveugles, NDA avant tout dossier détaillé.</p>
        </div>
        <div>
          <div class="text-4xl font-bold text-[var(--color-orange)] mb-4">03</div>
          <h3 class="text-xl font-bold mb-3">Frais IAD compétitifs</h3>
          <p class="text-white/70 leading-relaxed">Structure IAD Portugal, honoraires transparents, moins chers qu'un cabinet de conseil M&A classique.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ABOUT -->
  <section id="about" class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-sm font-semibold tracking-widest text-[var(--color-orange)] uppercase mb-3">À propos</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-anthracite)]">L'homme derrière TurnKey</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-12 items-start">
        <div class="md:col-span-1">
          <div class="relative">
            <img src="/photogreg.jpg" alt="Grégory Vincent" class="w-full rounded-lg shadow-xl" />
            <div class="absolute -bottom-4 -right-4 bg-[var(--color-orange)] text-white px-4 py-2 rounded-md text-sm font-semibold">AMI 11220</div>
          </div>
          <div class="mt-10 bg-[var(--color-cream)] p-6 rounded-lg">
            <p class="text-xs font-semibold tracking-widest text-[var(--color-orange)] uppercase mb-4">En bref</p>
            <ul class="space-y-3 text-sm text-[var(--color-anthracite)]">
              <li class="flex justify-between"><span class="text-[var(--color-anthracite)]/60">Structure</span><span class="font-semibold">IAD Portugal</span></li>
              <li class="flex justify-between"><span class="text-[var(--color-anthracite)]/60">Zone</span><span class="font-semibold">Lisbonne & limitrophes</span></li>
              <li class="flex justify-between"><span class="text-[var(--color-anthracite)]/60">Langues</span><span class="font-semibold">FR PT EN</span></li>
              <li class="flex justify-between"><span class="text-[var(--color-anthracite)]/60">Focus</span><span class="font-semibold">F&B Retail Atypique</span></li>
            </ul>
          </div>
        </div>
        <div class="md:col-span-2">
          <h3 class="text-3xl font-bold text-[var(--color-anthracite)] mb-2">Grégory Vincent</h3>
          <p class="text-lg text-[var(--color-orange)] font-semibold mb-8">Restaurateur et broker à Lisbonne</p>
          <div class="space-y-5 text-[var(--color-anthracite)]/80 leading-relaxed">
            <p>Installé à Lisbonne, j'exploite moi-même un commerce en parallèle de mon activité de broker. Ce n'est pas anecdotique — c'est ce qui change tout dans la façon dont je traite un dossier.</p>
            <p>Là où un agent immobilier lit un bilan comme un document comptable, je le lis comme un exploitant. Je vois les coûts qui ne sont pas dans les cases, les charges qui vont tomber, la marge réelle derrière le CA affiché, le potentiel d'un emplacement, les pièges d'un bail.</p>
            <p>Cette double casquette bénéficie aux deux côtés du marché : les <strong class="text-[var(--color-anthracite)]">cédants</strong> obtiennent une valorisation juste et défendable face à des acheteurs avertis. Les <strong class="text-[var(--color-anthracite)]">repreneurs</strong> ont un interlocuteur qui parle leur langue, qui a vécu ce qu'ils vont vivre, et qui les alerte sur ce qui ne va pas au lieu de survendre.</p>
            <p>J'accompagne les transmissions et acquisitions de commerces à Lisbonne : F&B, retail, services, atypique — dès lors qu'il y a pignon sur rue et un fonds à céder.</p>
          </div>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href="https://wa.me/351962350026" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-[#25D366] text-white px-5 py-3 rounded-md font-semibold hover:opacity-90 transition">WhatsApp</a>
            <a href="mailto:gregory.vincent@iadportugal.pt" class="inline-flex items-center gap-2 bg-[var(--color-anthracite)] text-white px-5 py-3 rounded-md font-semibold hover:opacity-90 transition">Email</a>
            <a href="tel:+351962350026" class="inline-flex items-center gap-2 bg-[var(--color-orange)] text-white px-5 py-3 rounded-md font-semibold hover:opacity-90 transition">Appeler</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-[var(--color-anthracite)] text-white py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-4 gap-8 mb-12">

        <div class="md:col-span-2">
          <img src="/logo.svg" alt="TurnKey" class="w-40 h-auto mb-4 bg-white p-2 rounded" />
          <p class="text-white/70 text-sm leading-relaxed max-w-md">
            TurnKey accompagne la transmission et l'acquisition de commerces à Lisbonne. Restaurateur et broker sous licence IAD Portugal AMI 11220.
          </p>
        </div>

        <div>
          <p class="text-xs font-semibold tracking-widest text-[var(--color-orange)] uppercase mb-4">Navigation</p>
          <ul class="space-y-2 text-sm text-white/70">
            <li><a href="#properties" class="hover:text-white transition">Mandats en cours</a></li>
            <li><button type="button" data-modal="seller" class="hover:text-white transition">Vendre</button></li>
            <li><button type="button" data-modal="buyer" class="hover:text-white transition">Reprendre</button></li>
            <li><a href="#about" class="hover:text-white transition">À propos</a></li>
            <li><a href="#contact" class="hover:text-white transition">Contact</a></li>
          </ul>
        </div>

        <div>
          <p class="text-xs font-semibold tracking-widest text-[var(--color-orange)] uppercase mb-4">Contact</p>
          <ul class="space-y-2 text-sm text-white/70">
            <li><a href="mailto:gregory.vincent@iadportugal.pt" class="hover:text-white transition">gregory.vincent@iadportugal.pt</a></li>
            <li><a href="tel:+351962350026" class="hover:text-white transition">+351 962 350 026</a></li>
            <li><a href="https://wa.me/351962350026" target="_blank" rel="noopener" class="hover:text-white transition">WhatsApp</a></li>
            <li class="pt-2 text-white/50 text-xs">Lisbonne, Portugal</li>
          </ul>
        </div>

      </div>

      <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <p class="text-xs text-white/50">
          &copy; 2026 TurnKey &middot; Grégory Vincent &middot; IAD Portugal &middot; AMI 11220
        </p>
        <div class="flex gap-6 text-xs text-white/50">
          <a href="/legal/mentions-legales" class="hover:text-white transition">Mentions légales</a>
          <a href="/legal/confidentialite" class="hover:text-white transition">Confidentialité</a>
          <a href="/legal/cookies" class="hover:text-white transition">Cookies</a>
        </div>
      </div>
    </div>
  </footer>


  <!-- MODALES -->
  <div id="modal-seller" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4">
    <div class="modal-backdrop absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
    <div class="relative bg-white rounded-lg shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <button type="button" data-close aria-label="Fermer" class="absolute top-3 right-4 text-gray-400 hover:text-[var(--color-anthracite)] text-3xl leading-none z-10">×</button>
      <div class="p-8 md:p-10 border-t-4 border-[var(--color-orange)] rounded-t-lg">
        <h3 class="text-2xl font-bold text-[var(--color-anthracite)] mb-2">Estimer mon commerce</h3>
        <p class="text-sm text-[var(--color-anthracite)]/70 mb-6">Vous vendez ? Recevez une estimation gratuite et confidentielle.</p>
        <form action="https://formspree.io/f/xjyklade" method="POST" class="space-y-4">
          <input type="hidden" name="_subject" value="Nouvelle demande estimation - TurnKey" />
          <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Nom complet *</label><input type="text" name="nom" required class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-orange)]" /></div>
          <div class="grid grid-cols-2 gap-4">
            <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Email *</label><input type="email" name="email" required class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-orange)]" /></div>
            <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Téléphone</label><input type="tel" name="telephone" class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-orange)]" /></div>
          </div>
          <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Type de commerce *</label><select name="type_commerce" required class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-orange)] bg-white"><option value="">Sélectionnez...</option><option>Restaurant / Café / Bar</option><option>Salon / Institut</option><option>Boutique / Retail</option><option>Bureau / Espace pro</option><option>Atypique</option><option>Autre</option></select></div>
          <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Zone</label><input type="text" name="zone" placeholder="Ex : Lapa, Chiado, Cascais..." class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-orange)]" /></div>
          <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">CA annuel approximatif</label><input type="text" name="ca_annuel" placeholder="Ex : 200-250k EUR" class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-orange)]" /></div>
          <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Contexte / Message</label><textarea name="message" rows="3" class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-orange)]"></textarea></div>
          <button type="submit" class="w-full bg-[var(--color-orange)] text-white py-4 rounded-md font-semibold hover:opacity-90 transition">Recevoir mon estimation</button>
          <p class="text-xs text-[var(--color-anthracite)]/60 text-center">Vos données restent confidentielles.</p>
        </form>
      </div>
    </div>
  </div>

  <div id="modal-buyer" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4">
    <div class="modal-backdrop absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
    <div class="relative bg-white rounded-lg shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <button type="button" data-close aria-label="Fermer" class="absolute top-3 right-4 text-gray-400 hover:text-[var(--color-anthracite)] text-3xl leading-none z-10">×</button>
      <div class="p-8 md:p-10 border-t-4 border-[var(--color-anthracite)] rounded-t-lg">
        <h3 class="text-2xl font-bold text-[var(--color-anthracite)] mb-2">Rejoindre la base repreneurs</h3>
        <p class="text-sm text-[var(--color-anthracite)]/70 mb-6">Vous cherchez ? Recevez les nouveaux mandats en priorité.</p>
        <form action="https://formspree.io/f/xqpanyow" method="POST" class="space-y-4">
          <input type="hidden" name="_subject" value="Nouveau repreneur - TurnKey" />
          <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Nom complet *</label><input type="text" name="nom" required class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-anthracite)]" /></div>
          <div class="grid grid-cols-2 gap-4">
            <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Email *</label><input type="email" name="email" required class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-anthracite)]" /></div>
            <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Téléphone</label><input type="tel" name="telephone" class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-anthracite)]" /></div>
          </div>
          <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Profil</label><select name="profil" class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-anthracite)] bg-white"><option value="">Sélectionnez...</option><option>Exploitant en activité</option><option>Premier achat</option><option>Investisseur</option><option>Family office</option><option>Autre</option></select></div>
          <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Type recherché</label><select name="type_recherche" class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-anthracite)] bg-white"><option value="">Sélectionnez...</option><option>F&B (Café / Restaurant / Bar / Hôtel)</option><option>Commerces (Salon / Boutique / Bureau)</option><option>Atypique</option><option>Ouvert à plusieurs</option></select></div>
          <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Budget</label><select name="budget" class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-anthracite)] bg-white"><option value="">Sélectionnez...</option><option>Moins de 100k €</option><option>100-250k €</option><option>250-500k €</option><option>500k-1M €</option><option>Plus de 1M €</option></select></div>
          <div><label class="block text-xs font-semibold text-[var(--color-anthracite)]/70 uppercase tracking-wider mb-1">Zone souhaitée</label><input type="text" name="zone" placeholder="Ex : Centre Lisbonne, Cascais..." class="w-full px-4 py-3 border border-gray-200 rounded-md focus:outline-none focus:border-[var(--color-anthracite)]" /></div>
          <button type="submit" class="w-full bg-[var(--color-anthracite)] text-white py-4 rounded-md font-semibold hover:opacity-90 transition">Rejoindre la base</button>
          <p class="text-xs text-[var(--color-anthracite)]/60 text-center">Vous serez notifié par email dès qu'un mandat correspond.</p>
        </form>
      </div>
    </div>
  </div>

  <div id="modal-choice" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4">
    <div class="modal-backdrop absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
    <div class="relative bg-white rounded-lg shadow-2xl max-w-md w-full p-8">
      <button type="button" data-close aria-label="Fermer" class="absolute top-3 right-4 text-gray-400 hover:text-[var(--color-anthracite)] text-3xl leading-none">×</button>
      <h3 class="text-2xl font-bold text-[var(--color-anthracite)] mb-2 text-center">Comment puis-je vous aider ?</h3>
      <p class="text-sm text-[var(--color-anthracite)]/70 mb-6 text-center">Choisissez le formulaire adapté à votre projet.</p>
      <div class="space-y-3">
        <button type="button" data-modal="seller" class="block w-full bg-[var(--color-orange)] text-white py-4 rounded-md font-semibold hover:opacity-90 transition">Je veux vendre mon commerce</button>
        <button type="button" data-modal="buyer" class="block w-full bg-[var(--color-anthracite)] text-white py-4 rounded-md font-semibold hover:opacity-90 transition">Je cherche à reprendre</button>
      </div>
    </div>
  </div>

  <script>
    (function(){
      function open(id){closeAll();var m=document.getElementById('modal-'+id);if(m){m.classList.remove('hidden');document.body.style.overflow='hidden';}}
      function closeAll(){document.querySelectorAll('[id^="modal-"]').forEach(function(m){m.classList.add('hidden');});document.body.style.overflow='';}
      document.addEventListener('click',function(e){
        var o=e.target.closest('[data-modal]');
        if(o){e.preventDefault();open(o.dataset.modal);return;}
        var c=e.target.closest('[data-close]')||(e.target.classList&&e.target.classList.contains('modal-backdrop')?e.target:null);
        if(c){e.preventDefault();closeAll();return;}
        var cl=e.target.closest('a[href="#contact"]');
        if(cl){e.preventDefault();open('choice');}
      });
      document.addEventListener('keydown',function(e){if(e.key==='Escape')closeAll();});
    })();
  </script>

</BaseLayout>
